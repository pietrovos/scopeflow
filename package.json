{
  "name": "scopeflow",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter e2e e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "pnpm --filter @scopeflow/api db:seed",
    "db:migrate": "pnpm --filter @scopeflow/api db:migrate"
  },
  "devDependencies": {
    "prettier": "3.7.3"
  }
}
