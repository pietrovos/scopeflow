    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.1.13"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.0.14"
  }
}
