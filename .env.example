# Copy to .env. Every value here works out of the box for local development.

# --- Database ---------------------------------------------------------------
# The API serves requests as scopeflow_app (row-level security applies) and uses
# scopeflow_owner only for migrations and a short list of system paths.
DATABASE_URL=postgresql://scopeflow_app:scopeflow_app@localhost:5544/scopeflow
DATABASE_OWNER_URL=postgresql://scopeflow_owner:scopeflow_owner@localhost:5544/scopeflow
TEST_DATABASE_URL=postgresql://scopeflow_app:scopeflow_app@localhost:5544/scopeflow_test
TEST_DATABASE_OWNER_URL=postgresql://scopeflow_owner:scopeflow_owner@localhost:5544/scopeflow_test

# --- Auth (Keycloak via OIDC) ------------------------------------------------
# Public issuer, as the browser sees it. Tokens carry this as `iss`.
OIDC_ISSUER=http://localhost:8180/realms/scopeflow
# Where servers reach Keycloak. Same as the issuer outside Docker.
OIDC_INTERNAL_URL=http://localhost:8180/realms/scopeflow
OIDC_AUDIENCE=scopeflow-api
AUTH_KEYCLOAK_ID=scopeflow-web
AUTH_KEYCLOAK_SECRET=scopeflow-web-dev-secret
# Auth.js session encryption key. Generate your own with `openssl rand -base64 32`.
AUTH_SECRET=dev-only-change-me-dev-only-change-me
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true

# --- App URLs -----------------------------------------------------------------
WEB_URL=http://localhost:3100
API_PORT=4100
NEXT_PUBLIC_API_URL=http://localhost:4100
API_INTERNAL_URL=http://localhost:4100

# --- Email --------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1125
MAIL_FROM="ScopeFlow <no-reply@scopeflow.local>"

# --- Stripe (test mode) -------------------------------------------------------
# Leave blank to run without billing; the settings page shows checkout as unavailable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
